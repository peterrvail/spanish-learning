    },
    "additional_practice_sentences": [
      {"spanish": "Anoche estaba caminando y me caí en el camino.", "english": "Last night I was walking and I fell on the road.", "note": "Imperfect (estaba caminando) sets background; preterite (caí) marks the event"},
