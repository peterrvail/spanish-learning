{
  "preterite_tense": {
    "overview": "El Pretérito Indefinido (Pasado Simple) expresa acciones completadas en el pasado, con principio y fin definidos. La mayoría de los verbos son regulares; los irregulares se organizan en grupos según su patrón.",
    "spanish_name": "El Pretérito Indefinido / Pasado Simple",
    "regular_conjugation": {
      "description": "Regular -AR verbs take one set of endings; regular -ER and -IR verbs share a second set.",
      "ar_endings": {
        "yo": "-é",
        "tú": "-aste",
        "él_ella_usted": "-ó",
        "nosotros": "-amos",
        "vosotros": "-asteis",
        "ellos_ustedes": "-aron"
      },
      "er_ir_endings": {
        "yo": "-í",
        "tú": "-iste",
        "él_ella_usted": "-ió",
        "nosotros": "-imos",
        "vosotros": "-isteis",
        "ellos_ustedes": "-ieron"
      },
      "example_verbs": {
        "hablar": {"yo": "hablé", "tú": "hablaste", "él_ella_usted": "habló", "nosotros": "hablamos", "vosotros": "hablasteis", "ellos_ustedes": "hablaron"},
        "comer": {"yo": "comí", "tú": "comiste", "él_ella_usted": "comió", "nosotros": "comimos", "vosotros": "comisteis", "ellos_ustedes": "comieron"},
        "vivir": {"yo": "viví", "tú": "viviste", "él_ella_usted": "vivió", "nosotros": "vivimos", "vosotros": "vivisteis", "ellos_ustedes": "vivieron"}
      },
      "common_regular_verbs": [
        {"infinitive": "hablar", "english": "to speak"},
        {"infinitive": "comer", "english": "to eat"},
        {"infinitive": "vivir", "english": "to live"},
        {"infinitive": "trabajar", "english": "to work"},
        {"infinitive": "comprar", "english": "to buy"},
        {"infinitive": "escribir", "english": "to write"},
        {"infinitive": "vender", "english": "to sell"},
        {"infinitive": "estudiar", "english": "to study"},
        {"infinitive": "aprender", "english": "to learn"},
        {"infinitive": "abrir", "english": "to open"},
        {"infinitive": "caminar", "english": "to walk"},
        {"infinitive": "bailar", "english": "to dance"},
        {"infinitive": "cocinar", "english": "to cook"},
        {"infinitive": "limpiar", "english": "to clean"},
        {"infinitive": "viajar", "english": "to travel"},
        {"infinitive": "romper", "english": "to break"},
        {"infinitive": "subir", "english": "to go up"},
        {"infinitive": "recibir", "english": "to receive"},
        {"infinitive": "decidir", "english": "to decide"},
        {"infinitive": "permitir", "english": "to allow"}
      ]
    },
    "grupo_completamente_irregulares": {
      "name": "Verbos totalmente irregulares (casos individuales)",
      "description": "These verbs don't follow any predictable pattern and must be memorized individually",
      "verbs": [
        {
          "infinitive": "dar",
          "english": "to give",
          "conjugation": {
            "yo": "di", "tú": "diste", "él_ella_usted": "dio",
            "nosotros": "dimos", "ellos_ustedes": "dieron"
          },
          "note": "Uses -ER/-IR endings despite being an -AR verb, and without accents"
        },
        {
          "infinitive": "ser",
          "english": "to be",
          "conjugation": {
            "yo": "fui", "tú": "fuiste", "él_ella_usted": "fue",
            "nosotros": "fuimos", "ellos_ustedes": "fueron"
          },
          "note": "IDENTICAL to IR in preterite; context determines meaning"
        },
        {
          "infinitive": "ir",
          "english": "to go",
          "conjugation": {
            "yo": "fui", "tú": "fuiste", "él_ella_usted": "fue",
            "nosotros": "fuimos", "ellos_ustedes": "fueron"
          },
          "note": "IDENTICAL to SER in preterite; context determines meaning"
        }
      ],
      "example_sentences": [
        {"spanish": "Patty no me dió una respuesta.", "english": "Patty didn't give me an answer."},
        {"spanish": "El guía fue amable.", "english": "The guide was kind. (ser)"},
        {"spanish": "El guía fue a la fiesta con su esposa.", "english": "The guide went to the party with his wife. (ir)"},
        {"spanish": "Fue un día increíble.", "english": "It was an incredible day."},
        {"spanish": "Yo fui una buena estudiante en la clase de francés.", "english": "I was a good student in French class."},
        {"spanish": "Anoche fui a la casa de mi amiga Cheryl.", "english": "Last night I went to my friend Cheryl's house."},
        {"spanish": "Yo fui feliz.", "english": "I was happy. (completed emotional state)"}
      ]
    },
    "verbos_patron_fuerte": {
      "description": "Strong irregular verbs that share an irregular stem plus one common set of endings: -e, -iste, -o, -imos, -isteis, -ieron (never accented).",
      "shared_endings": {"yo": "-e", "tú": "-iste", "él_ella_usted": "-o", "nosotros": "-imos", "vosotros": "-isteis", "ellos_ustedes": "-ieron"},
      "grupo_1_uv": {
        "name": "Grupo 1: raíz en -UV",
        "verbs": [
          {"infinitive": "estar", "stem": "estuv", "english": "to be (location/state)"},
          {"infinitive": "tener", "stem": "tuv", "english": "to have"},
          {"infinitive": "andar", "stem": "anduv", "english": "to walk"}
        ],
        "example_sentences": [
          {"spanish": "Yo estuve feliz en ese momento.", "english": "I was happy in that moment."},
          {"spanish": "Yo no estuve caminando porque estaba lloviendo.", "english": "I wasn't walking because it was raining.", "note": "Contrast: estuve (preterite) vs. estaba (imperfect background)"},
          {"spanish": "pero estuve ocupado.", "english": "but I was busy."},
          {"spanish": "estuvo en la sala de estar.", "english": "he/she was in the living room."}
        ]
      },
      "grupo_2_i": {
        "name": "Grupo 2: raíz en -I (clave irregular)",
        "verbs": [
          {"infinitive": "querer", "stem": "quis", "english": "to want"},
          {"infinitive": "venir", "stem": "vin", "english": "to come"},
          {"infinitive": "hacer", "stem": "hic", "english": "to do / make", "irregular_el_form": "hizo", "note": "3rd person singular is 'hizo' (c→z), not 'hico'"}
        ],
        "related_compound_verbs": [
          {"spanish": "prevenir", "english": "to prevent", "base": "venir"},
          {"spanish": "intervenir", "english": "to intervene", "base": "venir"},
          {"spanish": "deshacer", "english": "to undo", "base": "hacer"},
          {"spanish": "satisfacer", "english": "to satisfy", "base": "hacer", "note": "satisfizo, not satisfació"}
        ],
        "example_sentences": [
          {"spanish": "Ella no quiso ir a la fiesta.", "english": "She refused to go to the party.", "note": "Preterite of querer often means 'refused' in negative"},
          {"spanish": "Emma vino con un vino.", "english": "Emma came with a wine."},
          {"spanish": "Peter hizo muy bien la tarea de español y ganó una estrella de oro.", "english": "Peter did the Spanish homework very well and won a gold star."},
          {"spanish": "El niño no hizo caso.", "english": "The child didn't pay attention/obey."},
          {"spanish": "Él no quiso venir con nosotros.", "english": "He refused to come with us."}
        ]
      },
      "grupo_3_u": {
        "name": "Grupo 3: raíz en -U",
        "verbs": [
          {"infinitive": "poner", "stem": "pus", "english": "to put"},
          {"infinitive": "poder", "stem": "pud", "english": "to be able to"},
          {"infinitive": "saber", "stem": "sup", "english": "to know", "note": "Preterite of saber often means 'found out'"},
          {"infinitive": "caber", "stem": "cup", "english": "to fit"},
          {"infinitive": "haber", "stem": "hub", "english": "to have (auxiliary)"}
        ],
        "example_sentences": [
          {"spanish": "No puedo escucharte.", "english": "I can't hear you."},
          {"spanish": "Yo supe la verdad ayer.", "english": "I found out the truth yesterday."}
        ]
      },
      "grupo_4_j": {
        "name": "Grupo 4: raíz en -J",
        "ellos_ending": "eron",
        "note": "After the 'j', the 3rd person plural drops the 'i': -eron instead of -ieron (dijeron, not dijieron)",
        "verbs": [
          {"infinitive": "decir", "stem": "dij", "english": "to say / tell"},
          {"infinitive": "traer", "stem": "traj", "english": "to bring"},
          {"infinitive": "traducir", "stem": "traduj", "english": "to translate"}
        ]
      }
    },
    "verbos_ortograficos": {
      "description": "Regular verbs with a spelling (not sound) change — only in the YO form — to preserve the infinitive's pronunciation.",
      "car_to_que": {
        "change": "c → qu",
        "example": {"infinitive": "practicar", "yo_form": "practiqué"},
        "verbs": ["acercar(se)", "atacar", "buscar", "dedicar", "diagnosticar", "equivocar(se)", "explicar", "identificar", "justificar", "provocar", "sacar", "secar", "tocar", "ubicar", "unificar"]
      },
      "gar_to_gue": {
        "change": "g → gu",
        "example": {"infinitive": "pagar", "yo_form": "pagué"},
        "verbs": ["apagar", "castigar", "colgar", "conjugar", "entregar", "jugar", "juzgar", "llegar", "navegar", "negar", "obligar", "otorgar", "pegar", "rogar"]
      },
      "zar_to_ce": {
        "change": "z → c",
        "example": {"infinitive": "almorzar", "yo_form": "almorcé"},
        "verbs": ["abrazar", "analizar", "cazar", "comenzar", "cruzar", "empezar", "esforzar(se)", "lanzar", "localizar", "organizar", "realizar", "rechazar", "rezar", "simpatizar", "utilizar"]
      },
      "example_sentences": [
        {"spanish": "Yo practiqué alpinismo para disfrutar nuevas sensaciones.", "english": "I practiced climbing to enjoy new sensations."}
      ]
    },
    "verbos_semi_irregulares": {
