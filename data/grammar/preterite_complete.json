            {"infinitive": "freír", "english": "to fry", "él_ella_usted": "frió", "ellos_ustedes": "frieron"},
            {"infinitive": "impedir", "english": "to prevent", "él_ella_usted": "impidió", "ellos_ustedes": "impidieron"},
            {"infinitive": "medir", "english": "to measure", "él_ella_usted": "midió", "ellos_ustedes": "midieron"},
            {"infinitive": "mentir", "english": "to lie", "él_ella_usted": "mintió", "ellos_ustedes": "mintieron"},
