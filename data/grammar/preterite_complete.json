            {"infinitive": "competir", "english": "to compete", "él_ella_usted": "compitió", "ellos_ustedes": "compitieron"},
            {"infinitive": "conseguir", "english": "to get / manage to", "él_ella_usted": "consiguió", "ellos_ustedes": "consiguieron"},
            {"infinitive": "consentir", "english": "to consent", "él_ella_usted": "consintió", "ellos_ustedes": "consintieron"},
