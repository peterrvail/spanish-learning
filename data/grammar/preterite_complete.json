            {"infinitive": "seguir", "english": "to follow / continue", "él_ella_usted": "siguió", "ellos_ustedes": "siguieron"},
            {"infinitive": "sentir", "english": "to feel", "él_ella_usted": "sintió", "ellos_ustedes": "sintieron"},
            {"infinitive": "servir", "english": "to serve", "él_ella_usted": "sirvió", "ellos_ustedes": "sirvieron"},
            {"infinitive": "sonreír", "english": "to smile", "él_ella_usted": "sonrió", "ellos_ustedes": "sonrieron"},
            {"infinitive": "sugerir", "english": "to suggest", "él_ella_usted": "sugirió", "ellos_ustedes": "sugirieron"},
            {"infinitive": "vestirse", "english": "to get dressed", "él_ella_usted": "vistió", "ellos_ustedes": "vistieron"}
          ]
        },
        "o_to_u": {
          "note": "Same idea, but the stem vowel is o→u instead of e→i.",
          "verbs": [
            {"infinitive": "morir", "english": "to die", "él_ella_usted": "murió", "ellos_ustedes": "murieron"},
            {"infinitive": "dormir", "english": "to sleep", "él_ella_usted": "durmió", "ellos_ustedes": "durmieron"}
          ]
        }
      },
      "grupo_2_i_a_y": {
        "name": "Grupo 2: i→y, 3rd person only",
        "note": "When an -ER/-IR verb's stem ends in a vowel, the unstressed 'i' of -ió/-ieron becomes 'y'.",
        "verbs": [
