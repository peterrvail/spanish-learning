    "key_rule_le_to_se": {
      "rule": "When the indirect object pronoun is LE (him/her/you formal singular) or LES (them/you all formal), it MUST change to SE before a direct object pronoun.",
      "examples": [
        {
          "wrong": "~~Le lo expliqué.~~",
          "correct": "Se lo expliqué.",
          "english": "I explained it to him/her."
        },
        {
          "wrong": "~~Les la vendí.~~",
          "correct": "Se la vendí.",
          "english": "I sold it to them."
        },
        {
          "wrong": "~~Le los compré.~~",
          "correct": "Se los compré.",
          "english": "I bought them for him/her."
        }
      ],
      "note": "This is one of the most common errors; always remember: LE/LES → SE when followed by lo/la/los/las"
    },
    "affirmative_imperative_double_pronouns": {
      "rule": "In affirmative imperative, both clitics attach to the verb in the same order (IO + DO). Accents are required to preserve stress.",
      "examples": [
        {
          "verb": "Comprar (to buy)",
          "command": "¡Cómpramelo!",
          "breakdown": "Compra + me + lo",
          "english": "Buy it for me!"
        },
        {
          "verb": "Decir (to tell)",
          "command": "¡Dímelo!",
          "breakdown": "Di + me + lo",
          "english": "Tell me it!"
        },
        {
          "verb": "Mostrar (to show)",
          "command": "¡Muestramela!",
          "breakdown": "Muestra + me + la",
          "english": "Show it to me!"
        },
        {
          "verb": "Enviar (to send)",
          "command": "¡Envíaselo!",
          "breakdown": "Envía + se + lo",
          "english": "Send it to him/her!"
        },
        {
          "verb": "Pedir (to ask for)",
          "command": "¡Pídeme lo que quieras!",
          "breakdown": "Pide + me + lo que quieras",
          "english": "Ask me for whatever you want!",
          "note": "'lo que quieras' is a relative clause object, not a simple clitic, but still attaches after me"
        },
        {
          "verb": "Pedir (to ask for)",
          "command": "¡Pídeme 3 deseos!",
          "breakdown": "Pide + me + 3 deseos",
          "english": "Ask me for 3 wishes!",
          "note": "e→i stem change (pedir → pide) combined with clitic attachment"
        }
      ]
    },
    "pedir_full_paradigm_reference": {
      "note": "pedir (e→i stem change) is a common source of imperative + clitic errors",
      "present_indicative": {
        "yo": "pido", "tú": "pides", "él_ella": "pide",
        "nosotros": "pedimos", "ellos": "piden"
      },
      "example_sentences": [
        {"spanish": "I ask you a favor. Te pido un favor a ti.", "english": "I ask you for a favor."},
        {"spanish": "Tú me pides un favor a mí.", "english": "You ask me for a favor."},
        {"spanish": "Te pedí un favor.", "english": "I asked you for a favor. (preterite)"},
        {"spanish": "Tú me pediste un favor.", "english": "You asked me for a favor. (preterite)"}
      ]
    },
    "negative_imperative_double_pronouns": {
      "rule": "In negative imperative, both clitics appear before the verb in the same order (IO + DO). Uses subjunctive form.",
      "examples": [
        {
          "verb": "Decir (to tell)",
          "command": "¡No me lo digas!",
          "breakdown": "No + me + lo + digas (subjunctive)",
          "english": "Don't tell me it!"
        },
        {
          "verb": "Comprar (to buy)",
          "command": "¡No me los compres!",
          "breakdown": "No + me + los + compres (subjunctive)",
          "english": "Don't buy them for me!"
        },
        {
          "verb": "Mostrar (to show)",
          "command": "¡No se la muestres!",
          "breakdown": "No + se + la + muestres (subjunctive)",
          "english": "Don't show her to him!"
        }
      ]
    },
    "practice_transformations": [
      {
        "original_sentence": "Le expliqué el problema.",
        "with_pronoun": "Se lo expliqué.",
        "english": "I explained the problem to him. → I explained it to him.",
        "rule_applied": "LE→SE transformation; problem (lo) is DO"
      },
      {
        "original_sentence": "Les compré los libros.",
        "with_pronoun": "Se los compré.",
        "english": "I bought the books for them. → I bought them for them.",
        "rule_applied": "LES→SE transformation; books (los) is DO"
      },
      {
        "original_sentence": "Te presté la bicicleta.",
        "with_pronoun": "Te la presté.",
        "english": "I lent you the bicycle. → I lent it to you.",
        "rule_applied": "No transformation; TE stays TE; bicycle (la) is DO"
      },
      {
        "original_sentence": "Nos enviaron el paquete.",
        "with_pronoun": "Nos lo enviaron.",
        "english": "They sent us the package. → They sent it to us.",
        "rule_applied": "No transformation; NOS stays NOS; package (lo) is DO"
      }
